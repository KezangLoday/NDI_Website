# ─── Site ────────────────────────────────────────────────────────────────────
# Absolute origin of the deployed site: metadataBase, Payload serverURL, CSRF and CORS origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Payload CMS ─────────────────────────────────────────────────────────────
# Signs auth tokens and encrypts credentials; rotate per environment with `openssl rand -base64 48`.
PAYLOAD_SECRET=

# PostgreSQL connection string; the database must already exist.
# docker run -d --name ndi-website -p 5433:5432 -e POSTGRES_USER=admin -e POSTGRES_PASSWORD=admin -e POSTGRES_DB=ndi-website postgres:16
DATABASE_URI=postgres://admin:admin@localhost:5433/ndi-website

# Push schema straight to the DB instead of migrating; on by default outside production.
# DATABASE_PUSH=true

# ─── Storage ─────────────────────────────────────────────────────────────────
# Where uploads go: `local` disk or `s3`. Unset picks s3 when S3_BUCKET is set, else local.
# MEDIA_STORAGE=local

# Prefix for relative media URLs; empty serves from the app. Absolute URLs bypass it.
NEXT_PUBLIC_MEDIA_BASE_URL=

# ─── Amazon S3 (production) ──────────────────────────────────────────────────
# Setting S3_BUCKET switches storage to S3; all four are then required and must stay server-side.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Separate bucket for private applicant documents; defaults to S3_BUCKET with its own prefix.
# S3_PRIVATE_BUCKET=

# Key prefixes within the bucket(s).
# S3_PUBLIC_PREFIX=media
# S3_PRIVATE_PREFIX=applicant-documents

# ACL for public media; use `none` on buckets with bucket-owner-enforced ownership.
# S3_PUBLIC_ACL=public-read

# S3-compatible providers only (MinIO, R2, Spaces); leave unset for AWS.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# ─── Seeding ─────────────────────────────────────────────────────────────────
# First superadmin created by `pnpm seed`; change the password after first sign-in.
PAYLOAD_SEED_SUPERADMIN_EMAIL=admin@bhutanndi.bt
PAYLOAD_SEED_SUPERADMIN_PASSWORD=
