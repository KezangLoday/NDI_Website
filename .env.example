# Absolute origin of the deployed site. Used as metadataBase, so OG/Twitter
# image URLs resolve absolutely. Falls back to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prefix for media whose URL is stored relative. Empty means "serve from
# /public" (the current setup); point it at the CDN/bucket domain once Payload's
# storage adapter owns uploads. Absolute URLs bypass it — see src/lib/media.ts.
NEXT_PUBLIC_MEDIA_BASE_URL=
