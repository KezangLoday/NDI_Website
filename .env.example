# ─── Site ────────────────────────────────────────────────────────────────────
# Absolute origin of the deployed site. Used as metadataBase so OG/Twitter image
# URLs resolve absolutely, and as Payload's serverURL, CSRF origin and CORS
# origin. Falls back to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Payload CMS ─────────────────────────────────────────────────────────────
# Signs auth tokens and encrypts stored credentials. Generate a fresh one per
# environment: `openssl rand -base64 48`. Changing it signs everybody out.
PAYLOAD_SECRET=

# PostgreSQL connection string. The database is expected to exist already — the
# CMS does not create or manage the container. The local development container
# is `ndi-website` on port 5433:
#   docker run -d --name ndi-website -p 5433:5432 \
#     -e POSTGRES_USER=admin -e POSTGRES_PASSWORD=admin \
#     -e POSTGRES_DB=ndi-website postgres:16
DATABASE_URI=postgres://admin:admin@localhost:5433/ndi-website

# Push schema changes straight to the database instead of using migrations.
# Defaults to on outside production. Never turn this on against real data.
# DATABASE_PUSH=true

# ─── Storage ─────────────────────────────────────────────────────────────────
# Where uploads go: `local` writes to disk, `s3` writes to Amazon S3.
#
# Left unset, S3 is used when S3_BUCKET below is set and local disk otherwise —
# so filling in the bucket is all it takes to switch, and a production build can
# still be produced without credentials. A production deployment that ends up on
# local disk logs a loud warning, because a container's filesystem is ephemeral.
# MEDIA_STORAGE=local

# Prefix for media whose URL is stored relative. Empty means "serve from the
# app" (the local-storage setup); point it at the CloudFront or bucket domain in
# production. Absolute URLs bypass it — see src/lib/media.ts.
NEXT_PUBLIC_MEDIA_BASE_URL=

# ─── Amazon S3 (production) ──────────────────────────────────────────────────
# Setting S3_BUCKET switches storage to S3 on its own. All four are then
# required. The credentials must never reach the browser: none of these are
# NEXT_PUBLIC_.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Separate bucket for private applicant documents. Strongly recommended — it
# lets the public bucket carry a permissive read policy while recruitment data
# sits somewhere that has none. Defaults to S3_BUCKET with its own prefix.
# S3_PRIVATE_BUCKET=

# Key prefixes within the bucket(s).
# S3_PUBLIC_PREFIX=media
# S3_PRIVATE_PREFIX=applicant-documents

# ACL applied to public media. Set to `none` for a bucket with Object Ownership
# set to "bucket owner enforced" (the modern default), which rejects ACLs — then
# grant read on the public prefix with a bucket policy or CloudFront OAC
# instead. Applicant documents are always private and ignore this.
# S3_PUBLIC_ACL=public-read

# S3-compatible providers only (MinIO, Cloudflare R2, DigitalOcean Spaces).
# Leave both unset for AWS.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# ─── Seeding ─────────────────────────────────────────────────────────────────
# The first superadmin, created by `pnpm seed`. Change the password immediately
# after the first sign-in; these values are only meant to get you through the
# door.
PAYLOAD_SEED_SUPERADMIN_EMAIL=admin@bhutanndi.bt
PAYLOAD_SEED_SUPERADMIN_PASSWORD=
